# Copy this file to .env and fill in your own keys:  cp .env.example .env
# .env is git-ignored -- never commit real keys.

# --- Required: embeddings, generator and LLM judge ---
OPENAI_API_KEY=sk-your-openai-key

# --- Optional: LangSmith tracing, experiment logging, online evals ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=LLM-RAG-statquest-Evaluation
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
